    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 9 },
      "id": 4,
      "title": "Running vs Waiting Request Backlog",
      "type": "timeseries",
      "targets": [
        { "expr": "vllm:num_requests_running", "legendFormat": "Running Requests" },
        { "expr": "vllm:num_requests_waiting", "legendFormat": "Waiting Queue" }
