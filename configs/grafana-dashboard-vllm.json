      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(vllm:time_per_output_token_seconds_bucket[2m])) by (le))", "legendFormat": "P50 TPOT" },
        { "expr": "histogram_quantile(0.95, sum(rate(vllm:time_per_output_token_seconds_bucket[2m])) by (le))", "legendFormat": "P95 TPOT" }
      ]
